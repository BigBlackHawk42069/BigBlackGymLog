# Allowlist: ignore everything by default, then un-ignore only what belongs on GitHub.
# Anything new you create stays local unless you add it below.

/*
/Dev/*

# Repo config
!/.gitignore

# Builds
!/BigBlackGymLog.js
!/BigBlackGymLog.meta.js
!/Dev/
!/Dev/BBGLDev.js
!/Dev/BBGLDev.meta.js
!/Dev/BBGLRelease.js
!/Dev/BBGLRelease.meta.js

# Source
!/Dev/src/

# Docs
!/UserDocs/

# Images
!/Assets/
# Local only: working files, and the full-size masters (only web/ is served). jsDelivr refuses
# to serve any commit whose tree is over 50 MB, and the masters alone were ~67 MB.
/Assets/WorkingAssets-temp/
/Assets/Achievements/*
!/Assets/Achievements/web/
